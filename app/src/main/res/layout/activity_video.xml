<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:id="@+id/video_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/dark_red">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="64dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="64dp"
                    android:paddingBottom="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.03"
                        android:text="@string/app_name"
                        android:textColor="@color/white"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityHeading="true"
                        android:text="@string/menu_video"
                        android:textColor="@color/header_subtitle"
                        android:textSize="16sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="12dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/video_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_campaign_card"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="@string/video_title"
                    android:textColor="@color/primary_red"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/video_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/video_frame"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@color/black">

                        <WebView
                            android:id="@+id/video_web_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/video_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:text="@string/video_loading"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/video_retry"
                            style="@style/VideoControlButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/video_retry"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageButton
                                android:id="@+id/video_play"
                                style="@style/VideoControlIconButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:contentDescription="@string/video_play"
                                app:srcCompat="@drawable/ic_video_play" />

                            <androidx.appcompat.widget.AppCompatImageButton
                                android:id="@+id/video_pause"
                                style="@style/VideoControlIconButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:contentDescription="@string/video_pause"
                                app:srcCompat="@drawable/ic_video_pause" />

                            <androidx.appcompat.widget.AppCompatImageButton
                                android:id="@+id/video_stop"
                                style="@style/VideoControlIconButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:contentDescription="@string/video_stop"
                                app:srcCompat="@drawable/ic_video_stop" />

                            <androidx.appcompat.widget.AppCompatImageButton
                                android:id="@+id/video_fullscreen"
                                style="@style/VideoControlIconButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:contentDescription="@string/video_fullscreen"
                                app:srcCompat="@drawable/ic_video_fullscreen" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/video_fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />
</FrameLayout>
