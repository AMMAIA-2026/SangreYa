<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:orientation="vertical">

        <include layout="@layout/view_campaign_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/content_horizontal_padding"
                android:paddingTop="20dp"
                android:paddingEnd="@dimen/content_horizontal_padding"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_title"
                    android:textColor="@color/primary_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/profile_subtitle"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/profile_loading"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:contentDescription="@string/profile_loading"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/profile_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/primary_red"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/profile_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_dashboard_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                    android:id="@+id/profile_username_label_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/profile_username"
                    android:text="@string/profile_username_label"
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/profile_username"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="text"
                        android:maxLength="150"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/primary_text"
                        android:textSize="14sp" />

                <TextView
                    android:id="@+id/profile_email_label_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/profile_email"
                    android:text="@string/profile_email_label"
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/profile_email"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textEmailAddress"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/primary_text"
                        android:textSize="14sp" />

                <TextView
                    android:id="@+id/profile_dni_label_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/profile_dni"
                    android:text="@string/profile_dni_label"
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/profile_dni"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="number"
                        android:maxLength="8"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/primary_text"
                        android:textSize="14sp" />

                <TextView
                    android:id="@+id/profile_name_label_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/profile_name"
                    android:text="@string/profile_name_label"
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textCapWords"
                        android:maxLength="25"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/primary_text"
                        android:textSize="14sp" />

                <TextView
                    android:id="@+id/profile_last_name_label_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/profile_last_name"
                    android:text="@string/profile_last_name_label"
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/profile_last_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textCapWords"
                        android:maxLength="25"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/primary_text"
                        android:textSize="14sp" />

                <TextView
                    android:id="@+id/profile_birth_date_label_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/profile_birth_date"
                    android:text="@string/profile_birth_date_label"
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/profile_birth_date"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:focusable="true"
                        android:hint="@string/profile_birth_date_hint"
                        android:inputType="date"
                        android:maxLength="10"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/secondary_text"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/profile_save"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/action_button_height"
                        android:background="@drawable/bg_button_primary"
                        android:text="@string/profile_save_button"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/profile_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_navigation_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:elevation="5dp"
            android:background="@color/surface">

            <LinearLayout
                android:id="@+id/profile_campaigns_navigation_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_blood_drop"
                    android:contentDescription="@string/campaigns_navigation" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="@string/campaigns_navigation"
                    android:textColor="@color/secondary_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_enrollments_navigation_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_list"
                    android:contentDescription="@string/enrollments_navigation" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="@string/enrollments_navigation"
                    android:textColor="@color/secondary_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_navigation_item"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_profile"
                    android:tint="@color/primary_red"
                    android:contentDescription="@string/profile_navigation" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:text="@string/profile_navigation"
                    android:textColor="@color/primary_red"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/profile_navigation_view"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/navigation_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
