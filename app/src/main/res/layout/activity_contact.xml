<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/dark_red"
        android:paddingHorizontal="@dimen/content_horizontal_padding"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">



        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/surface"
            android:contentDescription="Volver"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contact_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contact_subtitle"
            android:textColor="@color/header_subtitle"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- FORMULARIO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/content_horizontal_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_full_name"
                android:textColor="@color/primary_text"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_full_name"
                android:textColorHint="@color/secondary_text"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email_label"
                android:textColor="@color/primary_text"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress"
                android:textColorHint="@color/secondary_text"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_reason"
                android:textColor="@color/primary_text"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerMotivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_message"
                android:textColor="@color/primary_text"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etMensaje"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="@string/hint_message"
                android:textColorHint="@color/secondary_text"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnEnviar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_button_height"
                android:text="@string/btn_send_message"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/contact_response_note"
                android:textColor="@color/secondary_text"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>