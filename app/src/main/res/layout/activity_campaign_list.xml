<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/content_horizontal_padding"
        android:paddingEnd="@dimen/content_horizontal_padding"
        android:paddingTop="8dp"
        android:background="@color/dark_red">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="29dp"
                android:text="@string/greeting"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:text="@string/campaign_subtitle"
                android:textColor="@color/header_subtitle"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_notifications"
            android:contentDescription="@string/notifications"
            android:background="@drawable/bg_bell" />
    </LinearLayout>



    <!--esto debemos borrarlo es para probar funcionamiento-->

    <Button
        android:id="@+id/about_us_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sobre nosotros"
        android:textAllCaps="false" />





    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/filter_row_height"
        android:scrollbars="none"
        android:paddingStart="@dimen/content_horizontal_padding"
        android:paddingEnd="@dimen/content_horizontal_padding">

        <LinearLayout
            android:id="@+id/filter_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <Button
                android:id="@+id/filter_all"
                android:layout_width="@dimen/filter_all_width"
                android:layout_height="@dimen/filter_height"
                android:text="@string/filter_all"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_filter_selected"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/filter_active"
                android:layout_width="@dimen/filter_active_width"
                android:layout_height="@dimen/filter_height"
                android:layout_marginStart="@dimen/filter_spacing"
                android:text="@string/filter_active"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_filter_unselected"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/filter_upcoming"
                android:layout_width="@dimen/filter_upcoming_width"
                android:layout_height="@dimen/filter_height"
                android:layout_marginStart="@dimen/filter_spacing"
                android:text="@string/filter_upcoming"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_filter_unselected"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/campaign_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_horizontal_padding"
            android:paddingEnd="@dimen/content_horizontal_padding"
            android:paddingBottom="18dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_navigation_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="5dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/campaigns_navigation" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center"
                android:text="@string/campaigns_navigation"
                android:textColor="@color/primary_red"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:src="@drawable/ic_list"
                android:contentDescription="@string/enrollments_navigation" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center"
                android:text="@string/enrollments_navigation"
                android:textColor="@color/secondary_text"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="@string/profile_navigation" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center"
                android:text="@string/profile_navigation"
                android:textColor="@color/secondary_text"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
