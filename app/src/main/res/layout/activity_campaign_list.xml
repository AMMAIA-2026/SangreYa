<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/campaign_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/app_background">

    <include layout="@layout/view_campaign_header" />



    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/filter_row_height"
        android:scrollbars="none"
        android:paddingStart="@dimen/content_horizontal_padding"
        android:paddingEnd="@dimen/content_horizontal_padding">

        <LinearLayout
            android:id="@+id/filter_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_all"
                android:layout_width="@dimen/filter_all_width"
                android:layout_height="@dimen/filter_height"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/filter_all"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@color/primary_red"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_active"
                android:layout_width="@dimen/filter_active_width"
                android:layout_height="@dimen/filter_height"
                android:layout_marginStart="@dimen/filter_spacing"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/filter_active"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@color/surface"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_upcoming"
                android:layout_width="@dimen/filter_upcoming_width"
                android:layout_height="@dimen/filter_height"
                android:layout_marginStart="@dimen/filter_spacing"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/filter_upcoming"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@color/surface"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/campaign_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_horizontal_padding"
            android:paddingEnd="@dimen/content_horizontal_padding"
            android:paddingBottom="18dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_navigation_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="5dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:src="@drawable/ic_blood_drop"
                android:tint="@color/primary_red"
                android:contentDescription="@string/campaigns_navigation" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center"
                android:text="@string/campaigns_navigation"
                android:textColor="@color/primary_red"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:src="@drawable/ic_list"
                android:contentDescription="@string/enrollments_navigation" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center"
                android:text="@string/enrollments_navigation"
                android:textColor="@color/secondary_text"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="@string/profile_navigation" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center"
                android:text="@string/profile_navigation"
                android:textColor="@color/secondary_text"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/campaign_navigation_view"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/navigation_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
