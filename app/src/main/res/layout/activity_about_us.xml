<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- HEADER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dark_red">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="28dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/white"
                android:contentDescription="@string/back"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingTop="36dp"
                android:paddingEnd="24dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SangreYa"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sobre nosotros"
                    android:textColor="@color/header_subtitle"
                    android:textSize="16sp" />

            </LinearLayout>

        </FrameLayout>

        <!-- INTRODUCCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:background="@color/surface">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Cada gota cuenta"
                android:textColor="@color/primary_red"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="SangreYa conecta personas dispuestas a donar sangre con campañas y centros de salud cercanos. Buscamos que encontrar una campaña y participar sea una experiencia simple, clara y accesible."
                android:textColor="@color/secondary_text"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>


        <!-- TÍTULO REQUISITOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="Requisitos para donar"
            android:textColor="@color/primary_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:text="Antes de inscribirte, revisá las indicaciones del centro de donación."
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />


        <!-- REQUISITO 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:padding="18dp"
            android:background="@color/surface"
            android:text="✓   Tener la edad requerida para donar"
            android:textColor="@color/primary_text"
            android:textSize="15sp" />

        <!-- REQUISITO 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="20dp"
            android:padding="18dp"
            android:background="@color/surface"
            android:text="✓   Cumplir con los requisitos de salud establecidos por el centro"
            android:textColor="@color/primary_text"
            android:textSize="15sp" />

        <!-- REQUISITO 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="20dp"
            android:padding="18dp"
            android:background="@color/surface"
            android:text="✓   Respetar el intervalo indicado desde la última donación"
            android:textColor="@color/primary_text"
            android:textSize="15sp" />

        <!-- REQUISITO 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="20dp"
            android:padding="18dp"
            android:background="@color/surface"
            android:text="✓   Haber descansado adecuadamente antes de donar"
            android:textColor="@color/primary_text"
            android:textSize="15sp" />

        <!-- REQUISITO 5 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="20dp"
            android:padding="18dp"
            android:background="@color/surface"
            android:text="✓   Seguir las indicaciones del personal de salud"
            android:textColor="@color/primary_text"
            android:textSize="15sp" />

        <!-- REQUISITO 6 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="20dp"
            android:padding="18dp"
            android:background="@color/surface"
            android:text="✓   Presentar la documentación solicitada"
            android:textColor="@color/primary_text"
            android:textSize="15sp" />


        <!-- CONTACTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@color/pale_red">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="¿Tenés más preguntas?"
                android:textColor="@color/primary_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Estamos para ayudarte."
                android:textColor="@color/secondary_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvContactanos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="Contactanos →"
                android:textColor="@color/primary_red"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>