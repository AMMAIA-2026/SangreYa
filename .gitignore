# Gradle
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Local Android configuration
/local.properties
captures/
.externalNativeBuild/
.cxx/

# Environment files and local secrets
.env
.env.*
!.env.example
!.env.template
secrets.properties
# Only credential-free Postman templates belong in the repository.
*.postman_environment.json
!*.template.postman_environment.json
# Private protections come after template exceptions and always take priority.
*.private.postman_environment.json
*.private.json
*.private.*
**/__pycache__/
*.py[cod]
node_modules/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
keystore.properties
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# Generated Android packages
*.apk
*.aab
*.aar
*.class

# Raw coverage and generated copies; public HTML/XML/JSON evidence is kept.
*.exec
*.ec
*.runtime.postman_collection.json

# Other IDEs and editor temporary files
.vscode/
.vs/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej

# Operating system files
.DS_Store
Thumbs.db

# Logs and crash dumps
*.log
*.hprof

# Do not ignore reportes/ or reports/: sanitized reports are delivery evidence.
# Do not add blanket exceptions for their contents: secrets/logs stay ignored.
